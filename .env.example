# Samptrapthi Environment Variables Configuration

# 1. Admin Authentication (Required - Server-side only)
# Used to authenticate administrators into the /admin operational control portal.
ADMIN_EMAIL=admin@samptrapthi.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_32_character_random_hex_or_base64_secret_here

# 2. Database Persistence (PostgreSQL - Neon / Supabase / Vercel Postgres)
# Compatible with free-tier managed PostgreSQL providers.
# If provided, the server persists catalogue modifications, stock levels, and checkout orders to PostgreSQL.
# If omitted in local development, server safely utilizes local file persistence (.data/db.json).
# In production on Vercel, DATABASE_URL is required for multi-client persistence.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

